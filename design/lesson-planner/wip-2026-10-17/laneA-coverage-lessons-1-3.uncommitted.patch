--- /dev/null
+++ b/js/modules/which-right.js
@@ -0,0 +1,118 @@
+// which-right.js — THE shared "Which is right?" response (skill coverage lane A, 2026-10-17).
+//
+// Every detailed lesson's Check Question asks "which is right?" A to D: one item of a skill, its right
+// answer and three of the skill provider's wrong answers (each a named misconception, the same set the
+// error-analysis and True or False? roles read). This module is the ONE place those choices are made:
+//
+//   whichRightAnswers(q)   {right, wrongs: [{display, misconception}]} from the item's provider -
+//                          its `wrongAnswers` list when it has one, else its `wrongAnswer` rotated
+//                          by seed (print-sheet.js's lesson Check Question reads this too)
+//   applyWhichRight(q)     the item turned into the choice, in place: answerType 'multiple-choice',
+//                          four options (the right one and three wrong ones, in a seeded order),
+//                          ans the right one, and the kit's `which-right` cell (print and key)
+//
+// The skill option is universal: `whichRight` (skill-options.js UNIVERSAL_OPTIONS, share key 5Z), so a
+// lesson's Check Question ref - `{categoryId, skillId, opts: {..., whichRight: true}}` - deals the same
+// item type online (practice card, online worksheet, quiz: answer buttons) and on paper (the
+// `which-right` cell, a tick box per answer). generate-question.js applies it after every other
+// post layer. An item whose provider gives fewer than two distinct wrong answers is left as it was
+// (a choice with one wrong answer is a coin toss), and so is an item that is already a choice.
+//
+// Layer 4 (reads the kit's provider registry; no DOM).
+
+import { getProvider } from './sheet/index.js';
+import { registerWhichRightFits } from './skill-options.js';
+
+// The control is offered on a skill whose provider names wrong answers (skill-options.js offeredOptionsFor).
+registerWhichRightFits((cat, skill) => {
+    let p = null;
+    try { p = getProvider(cat, skill); } catch (e) { p = null; }
+    return !!p && (typeof p.wrongAnswers === 'function' || typeof p.wrongAnswer === 'function');
+});
+
+/** The item's answer as one display string (an array joined, an object as JSON). */
+export const plainAnswer = (q) => (q && typeof q.ans === 'object' && q.ans !== null
+    ? (Array.isArray(q.ans) ? q.ans.join(', ') : JSON.stringify(q.ans))
+    : String(q && q.ans !== undefined ? q.ans : ''));
+
+/**
+ * The right answer and the provider's distinct wrong answers of one item.
+ * `rightOf(q)` writes the right answer the way the caller compares it (default: plainAnswer);
+ * `max` caps the rotated wrong answers (the `wrongAnswers` list is taken whole).
+ */
+export function whichRightAnswers(q, { rightOf = plainAnswer, max = 6 } = {}) {
+    let right = rightOf(q);
+    const wrongs = [];
+    let p = null;
+    try { p = getProvider((q && q.categoryId) || '', (q && q.skillId) || ''); } catch (e) { p = null; }
+    // A provider that lists EVERY misconception (`wrongAnswers`, with the right answer written the
+    // same way as `correct: true`) gives the options directly; else the one `wrongAnswer`, rotated.
+    let all = null;
+    try { all = p && typeof p.wrongAnswers === 'function' ? p.wrongAnswers(q) : null; } catch (e) { all = null; }
+    if (Array.isArray(all) && all.length) {
+        const r = all.find((w) => w.correct);
+        if (r) right = String(r.display);
+        for (const w of all) if (!w.correct && w.display !== undefined && !wrongs.some((x) => x.display === String(w.display))) wrongs.push({ display: String(w.display), misconception: w.misconception || '' });
+    }
+    const fromAll = wrongs.length > 0;
+    for (let s = 0; p && !fromAll && typeof p.wrongAnswer === 'function' && s < 40 && wrongs.length < max; s++) {
+        let w = null;
+        try { w = p.wrongAnswer(Object.assign({}, q, { seed: s })); } catch (e) { w = null; }
+        if (!w || w.display === undefined) continue;
+        const disp = String(w.display);
+        if (disp === right || wrongs.some((x) => x.display === disp)) continue;
+        wrongs.push({ display: disp, misconception: w.misconception || '' });
+    }
+    return { right, wrongs };
+}
+
+/** The item's question as plain lines (its story sentences, or its words), for the choice's stem. */
+function stemLines(q) {
+    const strip = (s) => String(s == null ? '' : s).replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
+    const p = q && q.cell && q.cell.payload;
+    const words = (v) => Array.isArray(v) && v.length && v.every((l) => typeof l === 'string');
+    if (p && words(p.lines)) return p.lines.map(strip).filter(Boolean);
