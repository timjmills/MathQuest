+// js/modules/sheet/cells/three-factors.js
+// The `three-factors` template (multiplication:multiply_three_numbers, skill coverage lane A 2026-10-17;
+// build list `mult_three`, 3.OA.B.5 associative property): one to two number sentences of three factors,
+// each written a pair at a time, the pupil's numbers in boxes.
+//
+// payload: {form, a, b, c, lines: [[part, ...], ...]}
+//   a part is a string (a number, a sign, a bracket) or {id, value} (a box the pupil writes; value = the key)
+//   form 0  (2 × 5) × 7 = [10] × 7 = [70]                  the easy pair bracketed (the prompt)
+//   form 1  2 × 7 × 5 = [10] × 7 = [70]                    no brackets: the pupil chooses the pair
+//   form 2  (3 × 4) × 2 = [12] × 2 = [24]                   two ways, the same product (associative)
+//           3 × (4 × 2) = 3 × [8] = [24]
+//   form 3  2 × [ ] × 7 = 70                               the missing factor
+//
+// Black and white, Andika, digits at the page's digit size (ctx metrics, ops-common geo), boxes at the
+// strip height. Key (AK-1): every box filled. Slot ids b0, b1, ... in reading order (on screen they join,
+// ", ", into the item's answer).
+//
+// Pure module (SCC-01).
+
+import { register } from '../registry.js';
+import { geo, root, inkOf, slotValues, box, esc, splitList } from './ops-common.js';
+
+const boxesOf = (p) => (p.lines || []).flat().filter((x) => x && typeof x === 'object');
+const keyOf = (p) => { const o = {}; boxesOf(p).forEach((x) => { o[x.id] = String(x.value); }); return o; };
+const boxW = (g, v) => Math.max(g.writeMm * (String(v).length > 1 ? 1.8 : 1.2), String(v).length * 0.62 * g.E + 3);
+
+function lineHTML(g, parts, at) {
+    return `<div style="display:inline-flex;align-items:center;gap:0.22em;white-space:nowrap">${parts.map((x) => (typeof x === 'object'
+        ? box(g, x.id, { wMm: boxW(g, x.value), hMm: g.stripMm, value: at(x.id).value, ink: at(x.id).ink, mark: 'cell' })
+        : `<span>${esc(x)}</span>`)).join('')}</div>`;
+}
+function widthMm(g, p) {
+    let w = 0;
+    for (const parts of p.lines || []) {
+        let lw = 0;
+        for (const x of parts) lw += (typeof x === 'object' ? boxW(g, x.value) : String(x).length * 0.62 * g.E) + 0.22 * g.E;
+        w = Math.max(w, lw);
+    }
+    return w;
