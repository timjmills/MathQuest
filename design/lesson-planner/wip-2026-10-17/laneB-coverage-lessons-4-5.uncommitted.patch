+// js/modules/sheet/cells/parity.js
+// The `parity` template (patterns:notice_patterns, build list patterns_notice; 3.OA.D.9, lessons 4-5
+// coverage 2026-10-17): is the product (or the sum) even or odd, and why?
+//
+//   The fact "7 × 4" (or "7 + 4") in digit-size bold, or - in a story item (payload.story) - the
+//   story's sentences at text size. Under it, the labelled check boxes (the box on the right of its
+//   label, P-TH-11, as `compare`): "Even" / "Odd", or with the reason bank (payload.why) the four
+//   statements "Even. One or both numbers are even." ... so ONE decision is ONE slot. The pupil never
+//   has to work the product out: the pattern is read from the two numbers (the property).
+//
+// Key (AK-1): the right box checked; Error analysis checks the wrong one (state `wrong`). In the screen
+// twin each row is a label span + an empty bordered box span, which screen-cell.js `wireTickBoxes`
+// turns into one tap target per row.
+//
+// payload: {op: 'x'|'+', a, b, labels: [...], values: [...], correct: i, story?: [lines]}
+//
+// Pure module (SCC-01).
+
+import { register } from '../registry.js';
+import { esc } from '../cell.js';
+import { L, P, root, checkBox, textPt, digitPt } from './k2kit.js';
+
+const GLYPH = { x: '×', '+': '+' };
+
+function checkedIndex(p, ctx) {
+    if (ctx.state === 'blank') return -1;
+    if (ctx.state === 'wrong') {
+        const w = String((ctx.wrong && ctx.wrong.value) || '').trim().toLowerCase();
+        const i = (p.values || []).findIndex((v) => String(v).toLowerCase() === w);
+        const j = (p.labels || []).findIndex((v) => String(v).toLowerCase() === w);
+        return i >= 0 ? i : j >= 0 ? j : (p.correct + 1) % Math.max(2, (p.labels || []).length);
+    }
+    return p.correct || 0;
+}
+
+/** The label column's width (mm): the longest label at the label size, so the boxes stand in one column. */
+const labelMm = (p, ctx) => Math.max(24, Math.ceil(Math.max(0, ...(p.labels || []).map((l) => String(l).length)) * (textPt(ctx) + 2) * 0.52 * 0.3528) + 2);
+
+register('parity', {
+    render(p, ctx) {
+        const on = checkedIndex(p, ctx);
+        const top = Array.isArray(p.story) && p.story.length
+            ? `<div class="par-story" style="display:inline-block;text-align:left;line-height:1.45;">${p.story.map((l) => `<div style="font-size:${P(ctx, textPt(ctx) + 2)};">${esc(String(l))}</div>`).join('')}</div>`
+            : `<div class="par-fact" style="font-size:${P(ctx, digitPt(ctx))};font-weight:700;line-height:1.2;white-space:nowrap;">${esc(p.a)} ${GLYPH[p.op] || esc(p.op)} ${esc(p.b)}</div>`;
+        const lab = labelMm(p, ctx);
+        const ticks = (p.labels || []).map((t, i) => `<div style="display:flex;align-items:center;gap:${L(ctx, 3)};margin:${L(ctx, 1.5)} 0;">`
+            // (the label column is the longest label's width, or the cell's: a narrow host wraps a label, never clips it)
+            + `<span style="flex:0 1 auto;width:${L(ctx, lab)};min-width:0;white-space:normal;text-align:left;line-height:1.25;font-size:${P(ctx, textPt(ctx) + 2)};">${esc(t)}</span>`
+            + checkBox(ctx, { id: `c${i}`, on: on === i, slot: false }) + '</div>').join('');
+        return root(ctx, 'par-cell', `${top}<div style="display:flex;justify-content:center;margin-top:${L(ctx, 3)};"><div data-ws-slot="answer" data-ws-shape="check"`
+            + `${on >= 0 ? ` data-ws-ink="${ctx.state === 'traced' ? 'trace' : 'solid'}"` : ''} style="display:inline-block;max-width:100%;">${ticks}</div></div>`);
+    },
+    answerKey(p) {
+        const i = p.correct || 0;
+        return { value: (p.values || [])[i], display: (p.labels || [])[i], slots: { answer: { value: (p.labels || [])[i], graded: true } } };
+    },
+    footprint(p) {
+        // (two short labels fit two across; the reason bank or a story takes the row)
+        const wide = !!(p && (p.why || (Array.isArray(p.story) && p.story.length)));
+        return { wMm: wide ? 150 : 70, hMm: null, measure: true, factLike: false, maxCols: wide ? 1 : 2 };
+    },
+    inputs() { return [{ id: 'answer', kind: 'check', shape: 'check', graded: true, order: 0, scopes: ['full'] }]; },
+    layout() { return { card: 'card-medium-visual', checker: 'choice' }; },
+});
+
+export default {};
