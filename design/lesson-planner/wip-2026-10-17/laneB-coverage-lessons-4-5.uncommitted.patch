+// gen-notice-patterns.js — patterns:notice_patterns, "Even or Odd? Patterns in the Tables"
+// (build list patterns_notice; 3.OA.D.9, lessons 4-5 coverage lane B, 2026-10-17).
+//
+// 3.OA.D.9: identify arithmetic patterns, including patterns in the ADDITION table and the
+// MULTIPLICATION table, and explain them using properties of operations ("4 times a number is always
+// even, because 4 x n can be split into two equal addends"). One item: two numbers, joined by x or +,
+// and the question "Is the product (sum) even or odd?" - read from the two numbers, never worked out:
+//   x : one or both numbers even -> even; both odd -> odd (an even number splits into two equal parts)
+//   + : both even or both odd -> even; one of each -> odd
+// With `npWhy` the pupil checks one of four sentences, the parity WITH its reason (the explain clause),
+// and the wrong sentences are the real errors ("Even. Both numbers are odd." - odd x odd taken as even;
+// "Odd. One or both numbers are even." - any odd number taken to make the product odd).
+// With `npStory` the two numbers come in a short story (bags of apples; red and blue cubes).
+//
+// The kit template is `parity` (sheet/cells/parity.js): one decision, one slot, the same check boxes on
+// paper, on the key and on screen (wireTickBoxes).
+
+import { state } from './state.js';
+import { randInt } from './utils.js';
+import { optionsFor, normalizeOptions } from './skill-options.js';
+import { k2Twin } from './sheet/index.js';
+
+let _cursor = 0;
+
+function npOptions() {
+    const mine = state.skill === 'notice_patterns' && state.skillOptions && typeof state.skillOptions === 'object' ? state.skillOptions : {};
+    try { return normalizeOptions('patterns', 'notice_patterns', mine); } catch (e) { /* defaults */ }
+    const out = {};
+    try { for (const d of optionsFor('patterns', 'notice_patterns')) out[d.id] = d.default; } catch (e) { /* none */ }
+    return out;
+}
+
+export const NP_LABELS = Object.freeze({
+    x: Object.freeze(['Even. One or both numbers are even.', 'Even. Both numbers are odd.', 'Odd. One or both numbers are even.', 'Odd. Both numbers are odd.']),
+    '+': Object.freeze(['Even. Both are even, or both are odd.', 'Even. One is even, one is odd.', 'Odd. Both are even, or both are odd.', 'Odd. One is even, one is odd.']),
+});
+
+const MULT_STORIES = [
+    ['bags', 'bag', 'apples'], ['boxes', 'box', 'pens'], ['plates', 'plate', 'cookies'], ['vases', 'vase', 'flowers'], ['nests', 'nest', 'eggs'],
+];
+const NAMES = ['Ben', 'Mia', 'Sam', 'Zara', 'Leo', 'Ivy', 'Omar', 'Ella'];
+
+/** Fill `q` with one even-or-odd item. */
+export function genNoticePatterns(q) {
+    const o = npOptions();
+    const at = Number.isFinite(state.itemIndex) ? state.itemIndex : _cursor++;
+    const table = o.npTable === 'mult' || o.npTable === 'add' ? o.npTable : (at % 2 === 0 ? 'mult' : 'add');
+    const op = table === 'mult' ? 'x' : '+';
+    const why = o.npWhy !== false;
+    const story = o.npStory === true;
+    let a, b;
+    if (op === 'x') {
+        const legal = [2, 3, 4, 5, 6, 7, 8, 9, 10];
+        let tabs = (Array.isArray(o.constant) ? o.constant : []).map(Number).filter((v) => legal.includes(v));
+        if (!tabs.length) tabs = legal.slice();
+        // about one item in three is odd x odd, when the ticked tables hold an odd one (the contrast case)
+        const odd = tabs.filter((v) => v % 2 === 1);
+        const bothOdd = odd.length > 0 && randInt(0, 2) === 0;
+        const t = bothOdd ? odd[randInt(0, odd.length - 1)] : tabs[randInt(0, tabs.length - 1)];
+        const pool = bothOdd ? [3, 5, 7, 9] : legal;
+        const other = pool[randInt(0, pool.length - 1)];
+        [a, b] = randInt(0, 1) === 0 ? [t, other] : [other, t];
+    } else {
+        a = randInt(1, 10); b = randInt(1, 10);
+    }
+    const value = op === 'x' ? a * b : a + b;
+    const even = value % 2 === 0;
+    const reasonFirst = op === 'x' ? (a % 2 === 0 || b % 2 === 0) : (a % 2 === b % 2);
+    const labels = why ? NP_LABELS[op].slice() : ['Even', 'Odd'];
+    const correct = why ? (even ? 0 : 2) + (reasonFirst ? 0 : 1) : (even ? 0 : 1);
+    const word = op === 'x' ? 'product' : 'sum';
+    const glyph = op === 'x' ? '×' : '+';
+    const payload = { op, a, b, labels, values: labels.slice(), correct, why };
+    if (story) {
+        const name = NAMES[(at + randInt(0, NAMES.length - 1)) % NAMES.length];
+        if (op === 'x') {
+            const [many, one, things] = MULT_STORIES[randInt(0, MULT_STORIES.length - 1)];
+            payload.story = [`There are ${a} ${a === 1 ? one : many}.`, `Each ${one} has ${b} ${things}.`, `How many ${things}? Even or odd?`];
+            payload.things = things;
+        } else {
+            payload.story = [`${name} has ${a} red cubes and ${b} blue cubes.`, 'How many cubes? Even or odd?'];
+            payload.things = 'cubes';
+        }
+        q.storyLines = payload.story.slice();
+    }
+    q.cell = { template: 'parity', v: 1, payload };
+    q.visual = k2Twin('parity', payload);
+    q.operands = [a, b];
+    q.a = a; q.b = b;
+    q.parity = even ? 'even' : 'odd';
+    q.npValue = value;
+    q.text = story ? payload.story.join(' ') : `Is ${a} ${glyph} ${b} even or odd?${why ? ' Why?' : ''}`;
+    q.printText = why ? 'Even or odd? Why? Check one box.' : 'Even or odd? Check one box.';
+    q.instructionKey = why ? 'parity-why' : 'parity';
+    q.ans = labels[correct];
+    q.printAnswer = labels[correct];
+    q.selfAnswering = true;
+    q.answerType = 'text';
+    q.options = [];
+    q.hint = op === 'x'
+        ? 'Look at the two numbers. Is one of them even? Then the product is even: it splits into two equal parts.'
+        : 'Look at the two numbers. Both even or both odd? Then the sum is even. One of each? The sum is odd.';
+    q.skillLabel = 'Even or Odd? Patterns in the Tables';
+    q.printFormat = 'parity';
+    q._variant = `${table}${why ? '-why' : ''}`;
+    q.npWord = word;
+}
