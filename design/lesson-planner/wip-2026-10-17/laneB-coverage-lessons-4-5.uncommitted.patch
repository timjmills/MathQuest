@@ -0,0 +1,27 @@
+// scratch (not committed): render kit independent pages for lane B skills + screen cards
+const fs = require('fs');
+const path = require('path');
+const { open, renderScreen, shoot } = require('../lib/ws-harness.cjs');
+const OUT = process.argv[2];
+(async () => {
+    const app = await open();
+    const jobs = [
+        ['np-default', 'patterns', 'notice_patterns', {}],
+        ['np-plain', 'patterns', 'notice_patterns', { npWhy: false }],
+        ['np-story', 'patterns', 'notice_patterns', { npStory: true, npTable: 'mult', npWhy: false }],
+        ['fts', 'algebra', 'function_table_story', {}],
+    ];
+    for (const [name, categoryId, skillId, opts] of jobs) {
+        const html = await app.page.evaluate(async ({ categoryId, skillId, opts }) => {
+            const r = await window.buildSheet({ role: 'independent', sections: [{ skills: [{ categoryId, skillId, opts }] }], size: 'L', look: 'ican', seed: 77, key: true });
+            return window.sheetDocument(r.docHtml || [r.pupilHtml, r.keyHtml].join('\n'), 'x');
+        }, { categoryId, skillId, opts });
+        const p = await app.page.browser().newPage();
+        await p.goto(app.base ? app.base + '/index.html' : 'about:blank');
+        await p.setContent(html, { waitUntil: 'load' });
+        await p.evaluate(() => document.fonts && document.fonts.ready);
+        await p.pdf({ path: path.join(OUT, name + '.pdf'), format: 'A4', printBackground: true });
+        await p.close();
+    }
+    await app.close();
+})().catch((e) => { console.error(e); process.exit(1); });
