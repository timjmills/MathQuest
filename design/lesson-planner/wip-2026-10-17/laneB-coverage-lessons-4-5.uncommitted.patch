new file mode 100644
index 00000000..b4614bc3
--- /dev/null
+++ b/js/modules/sheet/providers/parity.js
@@ -0,0 +1,70 @@
+// js/modules/sheet/providers/parity.js
+// The provider of patterns:notice_patterns (the `parity` template; lessons 4-5 coverage, 2026-10-17).
+// The item is the cell payload {op, a, b, labels, correct, why}; nothing here reads the text.
+//
+// Misconceptions (lesson 4 RESEARCH.md, PEDAGOGY P-1 error list):
+//   odd-odd-even     odd x odd taken as even (or odd + odd taken as odd)
+//   any-odd-odd      one odd number taken to make the product odd
+//   reason-only      the right Even / Odd with the wrong reason (the property not read)
+//
+// Pure module (SCC-01).
+
+import { registerSkill } from '../contract.js';
+import { chooseWrong, strings, step } from './util.js';
+
+const payloadOf = (q) => (q && q.cell && q.cell.template === 'parity' && q.cell.payload) || null;
+
+function workedSteps(q) {
+    const p = payloadOf(q);
+    if (!p) return [];
+    const right = p.labels[p.correct];
+    const ev = (n) => (n % 2 === 0 ? 'even' : 'odd');
+    if (p.op === 'x') {
+        const one = p.a % 2 === 0 || p.b % 2 === 0;
+        return [
+            step(`${p.a} is ${ev(p.a)}. ${p.b} is ${ev(p.b)}.`),
+            step(one ? 'One even number is enough: the product splits into two equal parts.' : 'Both are odd: one is left over.'),
+            step(`Check: ${right}`, [{ slot: 'answer', value: right }]),
+        ];
+    }
+    const same = p.a % 2 === p.b % 2;
+    return [
+        step(`${p.a} is ${ev(p.a)}. ${p.b} is ${ev(p.b)}.`),
+        step(same ? 'Both the same: the spare ones pair up. The sum is even.' : 'One of each: one is left over. The sum is odd.'),
+        step(`Check: ${right}`, [{ slot: 'answer', value: right }]),
+    ];
+}
+
+function wrongAnswer(q) {
+    const p = payloadOf(q);
+    if (!p) return null;
+    const L = p.labels;
+    const out = [];
+    if (p.why) {
+        // the parity flipped with the same reason; the right parity with the other reason
+        const flip = (p.correct + 2) % 4, other = p.correct % 2 === 0 ? p.correct + 1 : p.correct - 1;
+        out.push({ value: L[flip], misconception: p.op === 'x' && p.a % 2 && p.b % 2 ? 'odd-odd-even' : 'any-odd-odd', slot: 'answer', explain: 'Read the two numbers, then the rule: the reason and the answer must agree.' });
+        out.push({ value: L[other], misconception: 'reason-only', slot: 'answer', explain: 'The right word with the wrong reason.' });
+    } else {
+        out.push({ value: L[1 - p.correct], misconception: p.op === 'x' && p.a % 2 && p.b % 2 ? 'odd-odd-even' : 'any-odd-odd', slot: 'answer', explain: 'Even and odd swapped.' });
+    }
+    return chooseWrong(q, out);
+}
+
+const def = (key) => strings({
+    iCan: 'I Can tell if a product or a sum is even or odd',
+    instructionKey: key,
+    steps: ['Is each number even or odd?', 'Times: one even number makes it even. Plus: two the same make it even.', 'Check the box.'],
+    say: 'It is __ because __.',
+    sayValues: (q) => { const p = payloadOf(q); if (!p) return null; const t = String(p.labels[p.correct]); const [w, ...r] = t.split('. '); return [w.toLowerCase(), r.join('. ').replace(/\.$/, '').toLowerCase() || (w === 'Even' ? 'it makes pairs' : 'one is left over')]; },
+});
+const WHY = def('parity-why'), PLAIN = def('parity');
+const stringsFn = (ref = {}) => { const p = payloadOf(ref && ref.q); return (p && !p.why ? PLAIN : WHY)(ref); };
+stringsFn.def = WHY.def;
+
+registerSkill('patterns:notice_patterns', {
+    strings: stringsFn,
+    misconceptions: ['odd-odd-even', 'any-odd-odd', 'reason-only'],
+    workedSteps,
+    wrongAnswer,
+});
