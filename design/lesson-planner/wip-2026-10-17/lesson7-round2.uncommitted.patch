diff --git a/tests/scripts/_dbg7.cjs b/tests/scripts/_dbg7.cjs
new file mode 100644
index 00000000..5b18b94c
--- /dev/null
+++ b/tests/scripts/_dbg7.cjs
@@ -0,0 +1,18 @@
+// temporary debug harness (lesson 7 build) - deleted before commit
+const { open } = require('../lib/ws-harness.cjs');
+const fs = require('fs');
+(async () => {
+    const app = await open({ seed: 1 });
+    try {
+        const out = await app.page.evaluate(async (code) => (new Function('return (async () => {' + code + '})()'))(), fs.readFileSync(process.argv[2], 'utf8'));
+        if (out && out.html && process.argv[3]) {
+            const pg = await app.browser.newPage();
+            await pg.goto(app.page.url(), { waitUntil: 'domcontentloaded' });
+            await pg.setContent(out.html, { waitUntil: 'networkidle0' });
+            if (out.screen) { await pg.setViewport({ width: 700, height: 900 }); await pg.screenshot({ path: process.argv[3] + '.png', fullPage: true }); }
+            else { await pg.emulateMediaType('print'); await pg.pdf({ path: process.argv[3] + '.pdf', printBackground: true, preferCSSPageSize: true }); }
+            delete out.html;
+        }
+        console.log(JSON.stringify(out, null, 1).slice(0, 6000));
+    } finally { await app.close(); }
+})();
