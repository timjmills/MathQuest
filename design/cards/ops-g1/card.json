 "ownerRulings": [
  {
   "date": "2026-09-19",
   "ruling": "\"Within N\" bounds the ANSWER (the sum, the number you take from, the product, the number shared), never the operands.",
   "source": "CLAUDE.md"
  },
  {
   "date": "2026-10-17",
   "ruling": "A distinct option is ALSO a findable skill: 10 more / 10 less (and 100) and the answer-position step are listed as preset candidates for the lead, not built in G1.",
   "source": "CLAUDE.md"
  }
 ],
 "misconceptions": [
  {
   "id": "changed-ones",
   "error": "changed the ones digit instead of the tens (43 + 10 = 44)",
   "wrong": "a ± 1"
  },
  {
   "id": "changed-tens",
   "error": "changed the tens digit instead of the hundreds (367 + 100 = 377)",
   "wrong": "a ± 10"
  },
  {
   "id": "wrong-direction",
   "error": "added when the sign says take away",
   "wrong": "a ∓ step"
  },
  {
   "id": "subtracted-for-whole",
   "error": "SU-M7: subtracts when the unknown is the minuend (__ − 4 = 9 → 5)",
   "wrong": "|c − b|"
  },
  {
   "id": "added-the-numbers",
   "error": "adds the two numbers shown (7 + __ = 15 → 22)",
   "wrong": "known + c"
  },
  {
   "id": "multiplied-the-numbers",
   "error": "multiplies the two numbers shown (__ × 6 = 42 → 252)",
   "wrong": "b × c"
  },
  {
   "id": "left-out-zero",
   "error": "M-D2: skips the place the divisor does not go into (721 ÷ 7 = 13)",
   "wrong": "quotient with its inner / trailing 0 dropped"
  }
 ],
 "options": [
  "add_sub_10s / add_sub_100s: task (Adding / Subtracting; both = mixed, the instruction reads the sign), band (Numbers to 50 / 500, else 100 / 1,000).",
  "missing_add_sub: unknown (default: a number before the = sign; the answer is opt-in), task (+ / −).",
  "missing_mult_div: notation (Across default; Bracket / Fraction bar keep the equation's ÷ branch; several ticked mixes them by the teacher's choice).",
  "div_zero_in_quotient: Max Number 1,000 adds four-digit dividends.",
  "Preset candidates for the lead (not built): 10 more / 10 less, 100 more / 100 less (task presets), missing number with the answer position (unknown preset)."
 ],
